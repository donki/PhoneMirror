<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de sOC Phone Mirror: la logica (parseo de adb, protocolo de scrcpy, canal de control,
    geometria, argumentos, textos) y tambien las ventanas, la sesion de espejo y el descodificador
    H.264, con una plataforma falsa (Services\Desktop.cs), un adb de mentira (FakeAdb) y un
    servidor de scrcpy de mentira en loopback. Nada lanza el adb de verdad ni toca moviles, la red,
    el portapapeles ni el registro de quien trabaja.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PhoneMirror.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- La aplicacion entera (ventanas incluidas): se prueba con una plataforma falsa (Services\Desktop.cs). -->
    <ProjectReference Include="..\PhoneMirror.csproj" />
  </ItemGroup>

  <!--
    La referencia copia aqui el adb de verdad (Assets\platform-tools). Fuera: las pruebas nunca
    lanzan el adb de verdad y BundledAdb no debe encontrarlo (tocaria el PATH del usuario).
  -->
  <Target Name="QuitarAdbDeVerdad" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)Assets\platform-tools" />
  </Target>

  <ItemGroup>
    <!-- El adb de mentira es otro proyecto (un exe): no se compila aqui, se copia al lado. -->
    <Compile Remove="FakeAdb\**" />
    <None Remove="FakeAdb\**" />
    <ProjectReference Include="FakeAdb\FakeAdb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recursos con el prefijo Assets/ para probar BundledAssets.Ensure (los busca en el
         ensamblado que se ejecuta, que en las pruebas es este). -->
    <EmbeddedResource Include="TestAssets\hello.txt" LogicalName="Assets/test/hello.txt" />
    <EmbeddedResource Include="TestAssets\blocked.txt" LogicalName="Assets/test/blocked.txt" />
  </ItemGroup>

</Project>
