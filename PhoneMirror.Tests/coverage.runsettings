<?xml version="1.0" encoding="utf-8"?>
<!-- Se instrumenta la aplicacion entera (sOCPhoneMirror); ni las pruebas ni el adb de mentira. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <Include>[sOCPhoneMirror]*</Include>
          <Exclude>[FakeAdb]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
