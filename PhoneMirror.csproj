<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (icono de bandeja) vive en WinForms; se quitan sus usings implicitos porque
         chocan con WPF (Application, Color, KeyEventArgs...). Solo lo usa TrayIconHost, con alias. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PhoneMirror</RootNamespace>
    <AssemblyName>sOCPhoneMirror</AssemblyName>
    <ApplicationTitle>sOC Phone Mirror</ApplicationTitle>
    <Version>2026.9.16.1</Version>
    <AssemblyVersion>2026.9.16.1</AssemblyVersion>
    <FileVersion>2026.9.16.1</FileVersion>
    <Product>sOC Phone Mirror</Product>
    <Company>Socratic</Company>
    <Copyright>Copyright © 2026 Socratic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- El icono tambien como recurso, para el logo de «Acerca de». -->
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      El servidor de scrcpy (Apache 2.0) va tal cual al lado del ejecutable: se empuja al movil por
      adb en cada arranque. La version tiene que coincidir con ScrcpyProtocol.ServerVersion, porque
      el servidor la comprueba y el formato de los mensajes va ligado a ella.
    -->
    <None Include="Assets\scrcpy-server">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      adb y sus DLL (platform-tools de Google, Apache 2.0 en AOSP) van tambien al lado del
      ejecutable, en Assets\platform-tools; los deja ahi tools\get-platform-tools.ps1 (no van al
      repositorio). Con ellos el paquete ya no depende de que haya un adb en el equipo.
    -->
    <None Include="Assets\platform-tools\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Con PublishSingleFile, los .exe y .dll se intentan meter en el bundle y se pierden: sueltos. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
