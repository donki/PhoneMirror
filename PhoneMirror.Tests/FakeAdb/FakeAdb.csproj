<Project Sdk="Microsoft.NET.Sdk">

  <!-- Un adb de mentira para las pruebas de AdbService: dice lo que le manden las variables
       FAKE_ADB_OUT / FAKE_ADB_ERR / FAKE_ADB_EXIT y apunta sus argumentos en FAKE_ADB_LOG. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
