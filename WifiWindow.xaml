<Window x:Class="PhoneMirror.WifiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PhoneMirror.Localization"
        Title="{loc:T WifiTitle}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">

    <!--
        Conectar con un movil por Wi-Fi: la direccion (con las ya usadas en el desplegable) y, para
        la primera vez en Android 11+, el emparejamiento con codigo. Botones solo de icono, con su
        nombre en el tooltip (constitucion 6).
    -->

    <StackPanel Margin="16">

        <!-- Conectar -->
        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:T WifiIntro}" Style="{StaticResource HintText}" TextWrapping="Wrap" />

                <TextBlock Text="{loc:T WifiAddressLabel}" Margin="0,12,0,4"
                           Foreground="{DynamicResource TextPrimary}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AddressBox" Grid.Column="0" IsEditable="True" Height="36"
                              VerticalContentAlignment="Center" Padding="8,0"
                              KeyDown="OnAddressKeyDown" />
                    <Button x:Name="ForgetButton" Grid.Column="1" Style="{StaticResource GhostIconButton}"
                            Content="&#xE74D;" ToolTip="{loc:T WifiForgetTooltip}" Click="OnForgetClick" />
                    <Button x:Name="ConnectButton" Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE701;" ToolTip="{loc:T WifiConnectTooltip}" Click="OnConnectClick" />
                </Grid>

                <TextBlock Text="{loc:T WifiHint}" Style="{StaticResource HintText}" TextWrapping="Wrap"
                           FontSize="11" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Vincular (Android 11+) -->
        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:T WifiPairTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Primary}" />
                <TextBlock Text="{loc:T WifiPairIntro}" Style="{StaticResource HintText}" TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T WifiPairAddressLabel}"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:T WifiPairCodeLabel}"
                               Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,4" />
                    <TextBox x:Name="PairAddressBox" Grid.Row="1" Grid.Column="0" Height="36"
                             VerticalContentAlignment="Center" Padding="8,0"
                             Background="{DynamicResource CardBackground}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource Separator}" />
                    <TextBox x:Name="PairCodeBox" Grid.Row="1" Grid.Column="1" Height="36" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" Padding="8,0" MaxLength="6"
                             Background="{DynamicResource CardBackground}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource Separator}" />
                    <Button x:Name="PairButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE71B;" ToolTip="{loc:T WifiPairTooltip}" Click="OnPairClick" />
                </Grid>
            </StackPanel>
        </Border>

        <ProgressBar x:Name="Busy" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                     Foreground="{DynamicResource Primary}" Background="Transparent" BorderThickness="0" />

        <Grid Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,48,0" />
            <Button x:Name="CloseButton" Style="{StaticResource GhostIconButton}" Content="&#xE711;"
                    ToolTip="{loc:T Close}" HorizontalAlignment="Right" Click="OnCloseClick" />
        </Grid>
    </StackPanel>
</Window>
